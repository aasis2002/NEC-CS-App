rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to verify user authentication
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to verify user is accessing their own data
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Public syllabus & question catalog (Read-only for all authenticated & anonymous users)
    match /syllabus/{document=**} {
      allow read: if true;
      allow write: if false; // Admin managed only
    }

    match /questions/{questionId} {
      allow read: if true;
      allow write: if false; // Admin managed only
    }

    match /notes_manifest/{noteId} {
      allow read: if true;
      allow write: if false; // Admin managed only
    }

    // User-specific private collections (Enforcing strict user isolation)
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      // User's private progress per unit
      match /progress/{unitId} {
        allow read, write: if isOwner(userId);
      }

      // User's answer logs (used for repetition tracking & analytics)
      match /answer_logs/{logId} {
        allow read, write: if isOwner(userId);
      }

      // User's completed exam attempts
      match /exam_attempts/{attemptId} {
        allow read, write: if isOwner(userId);
      }

      // User's readiness score history
      match /readiness/{docId} {
        allow read, write: if isOwner(userId);
      }

      // Note completions & bookmarks
      match /note_states/{noteId} {
        allow read, write: if isOwner(userId);
      }
    }
  }
}
